root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140

[*.{xml,yml,yaml,json}]
indent_size = 2

[config/detekt-baseline.xml]
max_line_length = off
ij_xml_text_wrap = off
ij_xml_keep_line_breaks = true
